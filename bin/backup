LOG_ERRS="${RJN}.log"
LOG_FIFO="${RJN}.fifo"						# the fifo used to create the archive catalog file while the archive itself is being created


# -------------------- DO **NOT** EDIT BELOW THIS LINE --------------------


# [system]
DATETIME="$(date +'%Y-%m-%d %H:%M:%S')"				# sets a default epoch so in the event of failure, a full backup should be performed via this date for safety
EXT=								# the archive extension
FILE=								# a variable used in loops
FIND=								# the find command to feed the files into tar
LINE=								# a variable used in loops
TEMP=								# a variable used to hold temporary values

# [config]
ALERT_CALL=							# the binary or URL to use when reporting backup success|failure
ALERT_TYPE=							# the type of alert to send: binary, get, post
SIZE=								# the archive size
SID=								# the security identifier to authenticate your account with ALERT_CALL

# [job]
NAME='device'							# the job name
TYPE='full'							# which type of job to run: daily, full, incremental, sync
LIMIT='10'							# the number of backup archives to maintain
ALERT=								# what type of alerts to send upon success|failure
COMPRESSION=							# whether or not compression is used on the archive
PARAMETERS=							# binary parameters to pass to tar or rsync
PRECYCLE=							# whether the backup archive rotation needs to occur before or after a backup (default = after)
INCLUDE=							# the directories and files to include in the archive
EXCLUDE=							# the directories and files to exclude from the archive
SOURCE=								# the source device or network share
SOURCE_USER=							# the account parameters to mount a network share
SOURCE_PASS=
SOURCE_DOMN=
SOURCE_PARM=							# any parameters to pass to the 'mount' command for the SOURCE
SOURCE_HOST=							# the SOURCE host if using sshfs
SOURCE_FULL=							# the full SOURCE sshfs mount command
SOURCE_CALL=		# LEFT OFF - remove soon		# the syntax to enter the share password to sshfs
TARGET=
TARGET_USER=
TARGET_PASS=
TARGET_DOMN=
TARGET_PARM=
TARGET_HOST=
TARGET_FULL=
TARGET_CALL=
TAG1=								# tags to pass to ALERT_CALL
TAG2=
TAG3=
TAG4=





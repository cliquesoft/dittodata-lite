[ -e "/Users/Public/.${DIR_LIBS:1}/filesystem.sh" ] && . "/Users/Public/.${DIR_LIBS:1}/filesystem.sh"				# XSB - public
[ -e "${HOME}/.${DIR_LIBS:1}/filesystem.sh" ] && . "${HOME}/.${DIR_LIBS:1}/filesystem.sh"					# XSB - user




# DEFINE BUILT-IN FUNCTIONS FOR EXPORT




# DEFINE BUILT-IN FUNCTIONS FOR INTERNAL USE


# Usage syntax: exitGraceful [SUCCESS]
# Overview:	Performs cleanup routine whether the backup was a success or failure
# Parameters:
#		SUCCESS		[boolean] [optional] indicates the job success: 1+=failure, 0=success (default)
exitGraceful() {
	local SUCCESS=0
	[ $# -gt 0 ] && SUCCESS=$1				# if a value was passed, store it

	( mount | grep " on ${SOURCE}/${RJN}.s type " ) && umount "${SOURCE}/${RJN}.s" 2>>"${DIR_LOGS}/${LOG_ERRS}"
	if [ -L "${SOURCE}/${RJN}.s" ]; then			# if the file is actually a symlink, then...
		rm "${SOURCE}/${RJN}.s" 2>>"${DIR_LOGS}/${LOG_ERRS}"
	elif [ -e "${SOURCE}/${RJN}.s" ]; then			# otherwise it should be a blank directory as a mount point, so...
		rmdir "${SOURCE}/${RJN}.s" 2>>"${DIR_LOGS}/${LOG_ERRS}"
	fi

	( mount | grep " on ${TARGET}/${RJN}.t type " ) && umount "${TARGET}/${RJN}.t" 2>>"${DIR_LOGS}/${LOG_ERRS}"
	if [ -L "${TARGET}/${RJN}.t" ]; then			# if the file is actually a symlink, then...
		rm "${TARGET}/${RJN}.t" 2>>"${DIR_LOGS}/${LOG_ERRS}"
	elif [ -e "${TARGET}/${RJN}.t" ]; then			# otherwise it should be a blank directory as a mount point, so...
		rmdir "${TARGET}/${RJN}.t" 2>>"${DIR_LOGS}/${LOG_ERRS}"
	fi

	exit $SUCCESS						# exit with the passed error number (for debugging)
}


# Usage syntax: sizeConvert SIZE UNIT
# Overview:	converts the passed size into the passed unit; 1 Byte = 8 Bits
# Parameters:
#		SIZE		[string] the size to convert and must include a suffix: B(ytes), K(ilobyte 1000), Ki(bibyte 1024), M(egabyte), Mi(bibyte), 
#		UNIT		[string] the unit to convert the passed size to: B, b, KB, Ki, kb, MB, MiB, mb, etc
# Notes:
#		- kibibytes = 1024 (decimal) memory (--from=si) KiB
#		- kilobytes = 1000 (binary) storage (--from-iec) KB
#		- bits are indicated via lower case (e.g. kb); numfmt does NOT do conversion between bytes and bits
#		  http://www.pixelbeat.org/docs/numfmt.html
#		  https://www.man7.org/linux/man-pages/man1/numfmt.1.html
#		  https://physics.nist.gov/cuu/Units/binary.html
#		  https://stackoverflow.com/questions/19059944/convert-kb-to-mb-using-bash
#		  https://hexus.net/tech/tech-explained/storage/1376-gigabytes-gibibytes-what-need-know/
#		  https://unix.stackexchange.com/questions/346902/need-to-convert-bytes-to-gb-mb-kb-in-normal-decimal-format
sizeConvert() {
	local SIZE=$1
	local UNIT=$2
	local PRE=''						# number portion of string (prefix)
	local SUF=''						# unit portion of string (suffix)

	# validate SIZE suffix
	PRE=$(echo ${SIZE}|sed 's/[a-zA-Z]*//g')		# number
	SUF=$(echo ${SIZE}|sed 's/[0-9]*//g')			# unit
	case $SUF in
		'B') SIZE=$PRE ;;				# if we are dealing in bytes, we have to remove the 'B' suffix or numfmt will error
		'K'|'Ki'|'M'|'Mi'|'G'|'Gi'|'T'|'Ti'|'P'|'Pi'|'E'|'Ei') ;;
		*) echo "ERROR: The sizeConvert() function was passed an invalid value [SIZE]." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		   exitGraceful 1				# NOTE: this also picks up no value for SUF
			;;
	esac

	# validate UNIT
	case $UNIT in
		'B'|'K'|'Ki'|'M'|'Mi'|'G'|'Gi'|'T'|'Ti'|'P'|'Pi'|'E'|'Ei') ;;
		*) echo "ERROR: The sizeConvert() function was passed an invalid value [UNIT]." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		   exitGraceful 1
			;;
	esac

	numfmt --round=towards-zero --from=auto --to-unit=1${UNIT} --grouping ${SIZE}		# 'towards-zero' is basically truncation instead of rounding	https://askubuntu.com/questions/1169138/cutting-numbers-into-a-specific-decimals
	return 0
}


# Usage syntax: cycleArchives
# Overview:	cycles the backup archives
cycleArchives() {
	echo -n "Cycling the backups:" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	cd "${DIR_MNTS}/${RJN}.t/${NAME}" 2>>"${DIR_LOGS}/${LOG_ERRS}" || {
		echo -e " [failure]\nERROR: The job --target directory is not accessible." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		echo "Calling: cd \"${DIR_MNTS}/${RJN}.t/${NAME}\"" >>"${DIR_LOGS}/${LOG_ERRS}"
		return 1
	}
	# NOTE: we check the EXT as we do below in case the compression changes at some point
	TEMP=$(ls -rt1 2>>"${DIR_LOGS}/${LOG_ERRS}" | grep "${EXT:0:4}.."$)			# store all the job-related files
	if [ $? -ne 0 ]; then									# if the prior command failed (either 'ls' or 'ssh'), then...
		echo -e " [failure]\nERROR: The job archives can NOT be obtained to be cycled." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		echo "Calling: ls -rt1 | grep \"${EXT:0:4}..\"$" >>"${DIR_LOGS}/${LOG_ERRS}"
		echo -e "Value:\n${TEMP}" >>"${DIR_LOGS}/${LOG_ERRS}"
		return 1
	fi
	for FILE in $TEMP; do
		[ "$FILE" = "lost+found" ] && continue						# this is ONLY a safety precaution and should never be reached
		[ "$FILE" = "${RJN}${EXT}" ] && continue					# if we've iterated to the backup we just created (e.g. there is only one backup created so far), then continue

		# perform a check to see if we are within the count each iteration
		[ $(echo "$TEMP" | grep -c "${EXT:0:4}.."$) -le $LIMIT ] && break		# if the file count is less than the passed COUNT then the archive count is NOT MORE than should be, so we can exit
		echo -n " [over]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"				# otherwise, we are OVER the count defined, so delete the oldest ones until we get back into compliance (in case this number changes at some point)

		# delete the archive and associated catalog file
		rm "${FILE}" 2>>"${DIR_LOGS}/${LOG_ERRS}" || {
			echo -e " [failure]\nERROR: The cycled job archive (${FILE}) can NOT be deleted." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
			echo "Calling: rm \"${FILE}\"" >>"${DIR_LOGS}/${LOG_ERRS}"
			return 1
		}
		if [ -e "${FILE%.*}.cat" ]; then
			rm "${FILE%.*}.cat" 2>>"${DIR_LOGS}/${LOG_ERRS}" || {
				echo -e " [failure]\nERROR: The cycled job archive catalog (${FILE%.*}.cat) can NOT be deleted." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
				echo "Calling: rm \"${FILE%.*}.cat\"" >>"${DIR_LOGS}/${LOG_ERRS}"
				return 1
			}
		fi

		# remove the just-deleted archive from the TEMP listing (so the LIMIT comparison at the top works correctly)
		TEMP=$(echo "$TEMP" | sed "/${FILE}/d")

		# delete the associated logs (locally)
		if [ -e "${DIR_LOGS}/${FILE%%.*}.log" ]; then
			rm "${DIR_LOGS}/${FILE%%.*}.log" 2>>"${DIR_LOGS}/${LOG_ERRS}" || {
				echo -e " [failure]\nERROR: The cycled job archive log (${FILE%%.*}.log) can NOT be deleted." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
				echo "Calling: rm \"${DIR_LOGS}/${FILE%%.*}.log\"" >>"${DIR_LOGS}/${LOG_ERRS}"
				return 1
			}
		fi
	done
	echo " [done]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	return 0
}










# PROCESS PARAMETERS

if [ ! "$1" ] || [ "$1" = '--help' ]; then
	echo
	echo "  Usage: ${0##*/} [ACTION] [--OPTION=\"VALUE\" ...] [--config filename]"
	echo
	echo "  The lite version of our dittodata backup solution.  This edition can perform"
	echo "  full, incremental, or daily backups using tar. The filesystems of the source"
	echo "  and target devices are restricted to EXT and NTFS (local) and CIFS, NFS, and"
	echo "  sshfs (network)."
	echo
	echo "  [ACTIONS]"
	echo
	echo "  --help     this screen"
	echo "  --version  shows the version of this script"
	echo
	echo "  [OPTIONS]"
	echo
	echo "  --config   specifies a pre-built configuration via a text file.  The syntax"
	echo "             should contain a list of \"OPTION=VALUE\" pairs (one per line) for"
	echo "             anything that could be passed on the command line."
	echo
	echo "    {JOB}"
	echo
# REMOVED 2026/09/03 - this is a config-only parameter
#	echo "  --alerts    the file/URL to call to send the alert; variables can be passed"
	echo "  --alert   if an email alert should be sent upon the following action:"
	echo "		none|success|failure|all"
	echo "  --compression the compression to apply to the backup:"
	echo "		none|gzip|bzip"
	echo "  --exclude  the file containing the file(s) and/or dir(s) to exclude"
	echo "  --include  the file containing the file(s) and/or dir(s) to backup"
	echo "  --limit	   the number to limit the backup archive count"
	echo "  --name     the name of the backup job (enclose in quotes)"
	echo "  --parameters  custom parameters to pass to the underlying binary (tar/rsync)"
# DEV NOTE: the below cycles backups before the new backup archive is created; useful if you storage is limited; this does NOT run if nothing gets backed up
	echo "  --precycle cycles the backups before the backup occurs"
	echo "  --type     what type of backup job to perform:"
	echo "		daily|full|incremental|sync"
	echo
	echo "    {LOCATIONS}"
	echo
	echo "  --source   path -OR- device to backup"
	echo "                 NOTE: escape all backslashes not enclosed in SINGLE quotes"
	echo "                 absolute path example:      /local/dir               [local]"
	echo "                 network share examples:     //server:/share/dir      [Linux]"
	echo "                                             \\\\server\\share\\dir     [Windows]"
	echo "                                             %host:/dir               [sshfs]"
	echo "  --target   path -OR- device to store backups (defaults to /var/backups)"
	echo "                 NOTE: escape all backslashes not enclosed in SINGLE quotes"
	echo "                 absolute path example:      /local/dir               [local]"
	echo "                 network share examples:     //server:/share/dir      [Linux]"
	echo "                                             \\\\server\\share\\dir     [Windows]"
	echo "                                             %host:/dir               [sshfs]"
	echo
	echo "    {CREDENTIALS}"
	echo
	echo "  --source_user   network share username"
	echo "  --source_pass   network share password"
	echo "  --source_domn   network share domain (CIFS)"
	echo "  --source_parm   additional mount parameters to the pass"
	echo "  --target_user"
	echo "  --target_pass"
	echo "  --target_domn"
	echo "  --target_parm"
	echo
	echo "    {MISCELLANEOUS}"
	echo
	echo "  --tag1     user-defined values that can be passed to job alerts"
	echo "  --tag2"
	echo "  --tag3"
	echo "  --tag4"
	echo
	exit 0

elif [ "$1" = '--version' ] || [ "$1" = '-v' ]; then
	head -25 "$0" | grep "Updated	" | sed 's/.*\t//;s/ by .*//;s/-/./g'
	exit 0
fi


# obtain config file naming values
for i in "$@"; do						# process each of the passed parameters (after setting default values above)
	if ( echo "${i}" | grep -q ^'--config=' ); then
		TEMP="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--name=' ); then
		NAME="${i#*=}"
	fi
done

# load project config
[ -e "${DIR_CONF}/config" ] && . "${DIR_CONF}/config"										# ALL - system				DEV NOTE: mention how the various config files are processed
[ -e "/usr/local/${DIR_CONF}/config" ] && . "/usr/local/${DIR_CONF}/config"							# LSB - public
[ -e "${HOME}/.${DIR_CONF##*/}/config" ] && . "${HOME}/.${DIR_CONF##*/}/config"							# LSB - user
[ -e "/Users/Public/.${DIR_CONF:1}/config" ] && . "/Users/Public/.${DIR_CONF:1}/config"						# XSB - public
[ -e "${HOME}/.${DIR_CONF:1}/config" ] && . "${HOME}/.${DIR_CONF:1}/config"							# XSB - user

# load job config
[ -e "${DIR_CONF}/${NAME}" ] && . "${DIR_CONF}/${NAME}"										# ALL - system
[ -e "/usr/local/${DIR_CONF}/${NAME}" ] && . "/usr/local/${DIR_CONF}/${NAME}"							# LSB - public
[ -e "${HOME}/.${DIR_CONF##*/}/${NAME}" ] && . "${HOME}/.${DIR_CONF##*/}/${NAME}"						# LSB - user
[ -e "/Users/Public/.${DIR_CONF:1}/${NAME}" ] && . "/Users/Public/.${DIR_CONF:1}/${NAME}"					# XSB - public
[ -e "${HOME}/.${DIR_CONF:1}/${NAME}" ] && . "${HOME}/.${DIR_CONF:1}/${NAME}"							# XSB - user

# load passed config
[ "$TEMP" ] && [ -e "$TEMP" ] && . "$TEMP"

# process parameters (overwriting any config values)
for i in "$@"; do						# process each of the passed parameters (after setting default values above)
	if ( echo "${i}" | grep -q ^'--config=' ); then
		continue					# so that this doesn't trigger an invalid parameter prompt

	elif ( echo "${i}" | grep -q ^'--alert=' ); then
		ALERT="${i#*=}"
# REMOVED 2026/09/03 - this is a config-only parameter
#	elif ( echo "${i}" | grep -q ^'--alerts=' ); then
#		ALERTS="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--compression=' ); then
		COMPRESSION="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--exclude=' ); then
		EXCLUDE="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--include=' ); then
		INCLUDE="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--limit=' ); then
		LIMIT="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--name=' ); then
		NAME="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--parameters=' ); then
		PARAMETERS="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--precycle ' ); then
		PRECYCLE='TRUE'
	elif ( echo "${i}" | grep -q ^'--type=' ); then
		TYPE="${i#*=}"

	elif ( echo "${i}" | grep -q ^'--source=' ); then
		SOURCE="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--source_user=' ); then
# DEV NOTE: it is recommended to use a authentication file for this parameter
		SOURCE_USER="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--source_pass=' ); then
# DEV NOTE: it is recommended to use a authentication file for this parameter
		SOURCE_PASS="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--source_domn=' ); then
		SOURCE_DOMN="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--source_parm=' ); then
		SOURCE_PARM="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--target=' ); then
		TARGET="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--target_user=' ); then
# DEV NOTE: it is recommended to use a authentication file for this parameter
		TARGET_USER="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--target_pass=' ); then
# DEV NOTE: it is recommended to use a authentication file for this parameter
		TARGET_PASS="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--target_domn=' ); then
		TARGET_DOMN="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--target_parm=' ); then
		TARGET_PARM="${i#*=}"

	elif ( echo "${i}" | grep -q ^'--tag1=' ); then
		TAG1="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--tag2=' ); then
		TAG2="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--tag3=' ); then
		TAG3="${i#*=}"
	elif ( echo "${i}" | grep -q ^'--tag4=' ); then
		TAG4="${i#*=}"

	else
		echo "ERROR: This script was called with an invalid parameter (${i})." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		exit 1
	fi
done




# MANDATORY CHECKS BEFORE **ANY** PROCESSING


# directories		NOTE: we can't write to a log yet since these checks are occurring
if [ ! -d "${DIR_CONF}" ]; then
	mkdir -p "${DIR_CONF}" >/dev/null 2>&1 || { echo "ERROR: The configuration directory (DIR_CONF) does not exist and could not be created."; exit 1; }
fi
touch "${DIR_CONF}/writable" >/dev/null 2>&1 || { echo "ERROR: The configuration directory (DIR_CONF) is not writable."; exit 1; }
rm "${DIR_CONF}/writable" >/dev/null 2>&1

if [ ! -d "${DIR_LOGS}" ]; then
	mkdir -p "${DIR_LOGS}" >/dev/null 2>&1 || { echo "ERROR: The logs directory (DIR_LOGS) does not exist and could not be created."; exit 1; }
fi
touch "${DIR_LOGS}/writable" >/dev/null 2>&1 || { echo "ERROR: The logs directory (DIR_LOGS) is not writable."; exit 1; }
rm "${DIR_LOGS}/writable" >/dev/null 2>&1

if [ ! -d "${DIR_MNTS}" ]; then
	mkdir -p "${DIR_MNTS}" >/dev/null 2>&1 || { echo "ERROR: The mounting directory (DIR_MNTS) does not exist and could not be created."; exit 1; }
fi
touch "${DIR_MNTS}/writable" >/dev/null 2>&1 || { echo "ERROR: The mounting directory (DIR_MNTS) is not writable."; exit 1; }
rm "${DIR_MNTS}/writable" >/dev/null 2>&1

if ( echo "$SOURCE" | grep -q ^"/[a-zA-Z0-9_\.]" ); then	# if the SOURCE value is a local directory or mount point (e.g. starting with a '/' followed by an alphanumeric, underscore, or dot character), then...
	ln -s "${SOURCE}" "${DIR_MNTS}/${RJN}.s" >/dev/null 2>&1 || { echo "ERROR: The job --source can NOT be symlinked."; exit 1; }
else
	mkdir "${DIR_MNTS}/${RJN}.s" >/dev/null 2>&1 || { echo "ERROR: The job --source mount point directory can NOT be created."; exit 1; }
fi

if ( echo "$TARGET" | grep -q ^"/[a-zA-Z0-9_\.]" ); then
	ln -s "${TARGET}" "${DIR_MNTS}/${RJN}.t" >/dev/null 2>&1 || { echo "ERROR: The job --target can NOT be symlinked."; exit 1; }
else
	mkdir -p "${DIR_MNTS}/${RJN}.t" >/dev/null 2>&1 || { echo "ERROR: The job --target mount point directory can NOT be created."; exit 1; }
fi




echo -e "\n\n----------- [ Backup Started ] -----------" >>"${DIR_LOGS}/${LOG_ERRS}"
echo -e "           $(date +'%Y-%m-%d  %H:%M:%S')\n" >>"${DIR_LOGS}/${LOG_ERRS}"
echo -e "${0##*/} $@" >>"${DIR_LOGS}/${LOG_ERRS}"


# variables		NOTE: we can now write to the log
echo -n "Checking for necessary variable values:" | tee -a "${DIR_LOGS}/${LOG_ERRS}"

echo -n " [name]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ ! "${NAME}" ] && { echo -e " [failure]\nERROR: The backup job was called without the '--name' parameter." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }

echo -n " [type]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ ! "${TYPE}" ] && { echo -e " [failure]\nERROR: The backup job was called without the '--type' parameter." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }

echo -n " [limit]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ ! "${LIMIT}" ] && { echo -e " [failure]\nERROR: The backup job was called without the '--limit' parameter." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
( echo "${LIMIT}" | grep -q ^'[0-9]*'$ ) && { echo -e " [failure]\nERROR: The backup job was called without a numeric '--limit' value." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }

echo -n " [source]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ ! "${SOURCE}" ] && { echo -e " [failure]\nERROR: The backup job was called without the '--source' parameter." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
if [ "${SOURCE:0:1}" = '%' ]; then
	# if the path wasn't included in the SOURCE parameter, then...	NOTE: we need to test for ':' since 'host:' would be the users home directory
	( ! echo "$SOURCE" | grep -q ':' ) && { echo -e " [failure]\nERROR: The backup job was called without a directory in the SOURCE parameter." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
fi

echo -n " [target]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ ! "${TARGET}" ] && { echo -e " [failure]\nERROR: The backup job was called without the '--target' parameter." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
if [ "${TARGET:0:1}" = '%' ]; then
	# if the path wasn't included in the TARGET parameter, then...	NOTE: we need to test for ':' since 'host:' would be the users home directory
	( ! echo "$TARGET" | grep -q ':' ) && { echo -e " [failure]\nERROR: The backup job was called without a directory in the TARGET parameter." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
fi
echo " [done]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"




# alterations
echo -n "Making variable value alterations:" | tee -a "${DIR_LOGS}/${LOG_ERRS}"

if [ "${TYPE}" = 'sync' ]; then
	echo -n " [rsync]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"

	# if no custom parameters were passed, then set defaults
	[ ! "${PARAMETERS}" ] && PARAMETERS='-rlptgoDHEWzu --inplace --progress --partial-dir=InProgress --blocking-io --one-file-system'

	# NOTE: these are separate 'if' statements so that both --include and --exclude can be used simulatenously
	if [ "${EXCLUDE}" != '' ]; then
		PARAMETERS="$PARAMETERS --exclude-from=\"${EXCLUDE}\""
	fi
	if [ "${INCLUDE}" != '' ]; then
		PARAMETERS="$PARAMETERS --include=\"*/\" --include-from=\"${INCLUDE}\" --exclude=\"*\""
	fi
else
	echo -n " [tar]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"

	# if no custom parameters were passed, then set defaults
	[ ! "${PARAMETERS}" ] && PARAMETERS="-P --one-file-system --ignore-failed-read --ignore-case -T \"${DIR_TEMP}/${RJN}.list\""

	[ "${TYPE}" = 'daily' ] && EXT='.d.t'
	[ "${TYPE}" = 'full' ] && EXT='.f.t'
	[ "${TYPE}" = 'incremental' ] && EXT='.i.t'

	[ "$COMPRESSION" = 'gzip' ] && {
		EXT="${EXT}gz"			
		COMPRESSION='| gzip '				# NOTE: we can NOT add '-z' to PARAMETERS since it would alter the size being piped into 'pv' causing the progress meter to be incorrect
	}
	[ "$COMPRESSION" = 'bzip' ] && {
		EXT="${EXT}bz"
		COMPRESSION='| bzip2 '				# NOTE: ditto for '-j'
	}
	( [ "$COMPRESSION" = 'none' ] || [ ! "$COMPRESSION" ] ) && {
		EXT="${EXT}ar"
		COMPRESSION=''
	}

	[ ! "${INCLUDE}" ] && [ ! "${EXCLUDE}" ] && PARAMETERS="$PARAMETERS -C \"${DIR_MNTS}/${RJN}.s/\" ."			# if --include and --exclude were NOT passed, then have tar change into the SOURCE and backup all files (via '.')
fi

echo -n " [source]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ "${SOURCE_PARM}" ] && SOURCE_PARM="${SOURCE_PARM},ro" || SOURCE_PARM='ro'			# add a 'ro' here to make sure that nothing can happen to the SOURCE data

echo " [done]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"




# files
echo -n "Processing necessary files:" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
echo -n " [source]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
TEMP=
if [ "${SOURCE:0:2}" = '\\' ]; then
	echo -n " [cifs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	TEMP="${DIR_CONF}/$(echo "${SOURCE:2}" | sed 's/\\.*//')"				# store the location along with the isolated hostname as the filename
	( [ ! "$SOURCE_USER" ] || [ ! "$SOURCE_PASS" ] ) && [ ! -e "${TEMP}" ] && { echo -e " [failure]\nERROR: The SOURCE does not have an authentication file." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
elif [ "${SOURCE:0:1}" = '%' ]; then
	echo -n " [sshfs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	TEMP=$(echo "${SOURCE:1}" | sed 's/:.*//')						# isolate just the hostname
	( [ ! "$SOURCE_USER" ] || [ ! "$SOURCE_PASS" ] ) && [ ! -e "${DIR_CONF}/${TEMP}" ] && [ ! -e "${DIR_KEYS}/${TEMP}" ] && { echo -e " [failure]\nERROR: The SOURCE does not have an authentication or identity file." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
	[ -e "${DIR_KEYS}/${TEMP}" ] && TEMP= || TEMP="${DIR_CONF}/${TEMP}"			# if there isn't an identity file, then update the variable value so the below code works correctly
fi
# if TEMP has a value from one of the two conditions above -AND- an authentication file exists -AND- ...
if [ "$TEMP" ]; then
	[ $(stat -c '%u' "${TEMP}") -ne 0 ] && [ $(stat -c '%g' "${TEMP}") -ne 0 ] && { echo -e " [failure]\nERROR: The SOURCE authentication file is not owned by root." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
	[ $(stat -c '%a' "${TEMP}") -ne 660 ] && { echo -e " [failure]\nERROR: The SOURCE authentication file does not have 660 permissions." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }

	[ ! "$SOURCE_USER" ] && [ -e "${TEMP}" ] && SOURCE_USER=$(head -1 "${TEMP}")		# store the share username
	[ ! "$SOURCE_PASS" ] && [ -e "${TEMP}" ] && SOURCE_PASS=$(tail -1 "${TEMP}")		# store the share password
fi

echo -n " [target]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
TEMP=
if [ "${TARGET:0:2}" = '\\' ]; then
	echo -n " [cifs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	TEMP="${DIR_CONF}/$(echo "${TARGET:2}" | sed 's/\\.*//')"
	( [ ! "$TARGET_USER" ] || [ ! "$TARGET_PASS" ] ) && [ ! -e "${TEMP}" ] && { echo -e " [failure]\nERROR: The TARGET does not have an authentication file." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
elif [ "${TARGET:0:1}" = '%' ]; then
	echo -n " [sshfs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	TEMP=$(echo "${TARGET:1}" | sed 's/:.*//')
	( [ ! "$TARGET_USER" ] || [ ! "$TARGET_PASS" ] ) && [ ! -e "${DIR_CONF}/${TEMP}" ] && [ ! -e "${DIR_KEYS}/${TEMP}" ] && { echo -e " [failure]\nERROR: The TARGET does not have an authentication or identity file." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
	[ -e "${DIR_KEYS}/${TEMP}" ] && TEMP= || TEMP="${DIR_CONF}/${TEMP}"
fi
if [ "$TEMP" ]; then
	[ $(stat -c '%u' "${TEMP}") -ne 0 ] && [ $(stat -c '%g' "${TEMP}") -ne 0 ] && { echo -e " [failure]\nERROR: The TARGET authentication file is not owned by root." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }
	[ $(stat -c '%a' "${TEMP}") -ne 660 ] && { echo -e " [failure]\nERROR: The TARGET authentication file does not have 660 permissions." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exit 1; }

	[ ! "$TARGET_USER" ] && [ -e "${TEMP}" ] && TARGET_USER=$(head -1 "${TEMP}")		# store the share username
	[ ! "$TARGET_PASS" ] && [ -e "${TEMP}" ] && TARGET_PASS=$(tail -1 "${TEMP}")		# store the share password
fi

echo " [done]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
# DEV NOTE:
#	- An authentication file is required to mount network & remote shares.
#	  The format is only two lines, username and password respectively. It		< can supply only one value, but they have to be on the appropriate line (e.g. password on line 2)
#	  also requires complete root ownership & 660 permissions in DIR_CONF.
#	alternatively, an sshfs can also have an identity file
#	both instances require the file to be named the same as the host




# PERFORM SOME ACTUAL WORK

# check for elevated priviledges
EUID=$(id -u)							# if EUID is not already set, then obtain its value
if [ $EUID -gt 0 ]; then
	echo "ERROR: This script requires elevated priledges, try with sudo or root." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	exitGraceful 1
fi




# Grab the Ctrl-C signal and cleanup the environment
trap "exitGraceful 1" SIGINT




# process the locations
echo -n "Processing the locations:" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
echo -n " [source]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ "${SOURCE:0:2}" = '//' ] && echo -n " [nfs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ "${SOURCE:0:2}" = '\\' ] && echo -n " [cifs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ "${SOURCE:0:1}" = '%' ] && echo -n " [sshfs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ "${SOURCE:0:1}" = '/' ] && echo -n " [local]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
Filesystem_Mount "$SOURCE" "${DIR_MNTS}/${RJN}.s" "${DIR_LOGS}/${LOG_ERRS}" "$SOURCE_PARM" "$SOURCE_USER" "$SOURCE_PASS" || { echo ' [failure]'; exitGraceful 1; }

echo -n " [target]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"		# -- SEE THE NOTES FROM THE *SOURCE* ABOVE --
[ "${TARGET:0:2}" = '//' ] && echo -n " [nfs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ "${TARGET:0:2}" = '\\' ] && echo -n " [cifs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ "${TARGET:0:1}" = '%' ] && echo -n " [sshfs]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
[ "${TARGET:0:1}" = '/' ] && echo -n " [local]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
Filesystem_Mount "$TARGET" "${DIR_MNTS}/${RJN}.t" "${DIR_LOGS}/${LOG_ERRS}" "$TARGET_PARM" "$TARGET_USER" "$TARGET_PASS" || { echo ' [failure]'; exitGraceful 1; }
echo " [done]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"




# process the data
if [ "$TYPE" = 'sync' ]; then
	# NOTE: this method speeds up the sync'ing
	# https://unix.stackexchange.com/questions/260616/reuse-rsync-dry-run-output-to-speed-up-the-actual-transfer-later-on
	echo -n "Obtaining files list to sync:" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	( eval "rsync -av --dry-run ${PARAMETERS} \"${DIR_MNTS}/${RJN}.s/\" \"${DIR_MNTS}/${RJN}.t/\"" 2>>"${DIR_LOGS}/${LOG_ERRS}" || {
		echo -e " [failure]\nERROR: The 'rsync' binary failed in its execution." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		echo "Calling: rsync -av --dry-run ${PARAMETERS} \"${DIR_MNTS}/${RJN}.s/\" \"${DIR_MNTS}/${RJN}.t/\"" >>"${DIR_LOGS}/${LOG_ERRS}"
	} ) | awk '!/^sending incremental file list$/' | awk '/^$/{exit}1' >"${DIR_TEMP}/${RJN}.list"
	echo " [done]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"

	TEMP=$(cat "${DIR_TEMP}/${RJN}.list" | wc -l)						# store the files-to-be-xferred count for 'pv' below
	if [ "$TEMP" = '0' ] || [ ! "$TEMP" ]; then						# NOTE: the !TEMP would occur if no files were returned from 'rsync' (e.g. no new data was available yet)
		echo "There does NOT appear to be any data that needs to be sync'ed." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		exitGraceful 0
	else
		echo "Sync'ing the data..." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		( eval "rsync -v --log-file=\"${DIR_LOGS}/${LOG_ERRS}\" --out-format=\"%n\" --include-from=\"${DIR_TEMP}/${RJN}.list\" --delete ${PARAMETERS} \"${DIR_MNTS}/${RJN}.s/\" \"${DIR_MNTS}/${RJN}.t/\"" 2>>"${DIR_LOGS}/${LOG_ERRS}" || {
			echo "ERROR: The 'rsync' binary failed in its execution." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
			echo "Calling: rsync -v --log-file=\"${DIR_LOGS}/${LOG_ERRS}\" --out-format=\"%n\" --include-from=\"${DIR_TEMP}/${RJN}.list\" --delete ${PARAMETERS} \"${DIR_MNTS}/${RJN}.s/\" \"${DIR_MNTS}/${RJN}.t/\"" >>"${DIR_LOGS}/${LOG_ERRS}"
		} ) | pv -w 80 -l -s "$TEMP" >/dev/null
	fi

else
	echo -n "Setting up the catalog fifo:" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	mkfifo "${DIR_TEMP}/${LOG_FIFO}"
	trap 'rm "${DIR_TEMP}/${LOG_FIFO}"' EXIT
	# EXPLAINATION: 'cat' reads the FIFO output from 'tar', send to 'awk' which separates the output to the correct (cata)log file based on regex matching
	# https://askubuntu.com/questions/1093843/how-to-split-input-to-two-pipes
	# https://stackoverflow.com/questions/64143011/searching-for-multiple-strings-in-awk
	# https://www.baeldung.com/linux/exec-command-in-shell-script 				  can possibly use some tips in here for redirects as well if needed
	touch "${DIR_MNTS}/${RJN}.t/${NAME}/${RJN}${EXT:0:3}cat"				# this is so that a file will be present no matter what (to prevent errors if no data is backed up)
	( cat <"${DIR_TEMP}/${LOG_FIFO}" | awk "/^tar: Removing leading |file is unchanged; not dumped$|: Cannot open: Text file busy$|: Warning: Cannot stat: No such file or directory$|^Total bytes /{print >>\"${DIR_LOGS}/${LOG_ERRS}\"}; !/^.\/|^[a-zA-Z]:\//{print >> \"${DIR_LOGS}/${LOG_ERRS}\"}; /^.\/|^[a-zA-Z]:\// && !/\/$/{print > \"${DIR_MNTS}/${RJN}.t/${NAME}/${RJN}${EXT:0:3}cat\"}" ) &
	PID=$!											# store the pid of these background processes so they can be killed later
	echo " [done]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"

	echo -n "Checking the job storage directory:" | tee -a "${DIR_LOGS}/${LOG_ERRS}"
	if [ ! -e "${DIR_MNTS}/${RJN}.t/${NAME}" ]; then					# NOTE: this can't be at the top in case this is on a mounted filesystem
		echo -n ' [creating]' | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		mkdir "${DIR_MNTS}/${RJN}.t/${NAME}" >/dev/null 2>&1 || { echo -e " [failure]\nERROR: The job --target job directory can NOT be created." | tee -a "${DIR_LOGS}/${LOG_ERRS}"; exitGraceful 1; }
	fi
	echo " [done]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"

	echo -n "Obtaining size of the archive data set:" >>"${DIR_LOGS}/${LOG_ERRS}"
# LEFT OFF - if no --include or --exclude was passed, can we just do a 'df'
	# NOTE: this is processed so that both --include and --exclude can be used simulatenously
	TEMP='|'						# create the initial value in the layout: dirs|patterns (e.g. 'Common Profiles|-name *.pdf -o -name *.mdb')
	for FILE in "$INCLUDE" "$EXCLUDE"; do
		[ "$FILE" = '' ] && continue			# if either file was not used, then skip it
		[ ! -e "$FILE" ] && continue			# if either file does not exist, then skip it

		while read LINE; do				# read the include file line-by-line to assign either '-name' (file) or '-wholename' (dir) appropriately
			[ "$LINE" = '' ] && continue						# skip blank lines
			( echo "$LINE" | grep -q ^'#' ) && continue				# skip comments

			( echo "${LINE:0:2}" | grep -q ^'./' ) || LINE="./${LINE}"		# if the dir doesn't have a preceeding './', then add it (since the catalog file is generated based on this)

			if ( echo "$LINE" | grep -q '/'$ ); then				# if the line ends with a '/', then it's a directory so add it at the beginning
				TEMP="$(echo "${TEMP}" | sed "s:|:${LINE} |:")"
			elif ( echo "$LINE" | grep -q '/' ); then				# if the line contains a '/', then it needs to use 'wholename', so add it at the end
				[ "$FILE" = "$INCLUDE" ] && TEMP="${TEMP} -o -wholename \"${LINE// /\\ }\""
				[ "$FILE" = "$EXCLUDE" ] && TEMP="${TEMP} -a ! -wholename \"${LINE// /\\ }\""
			else									# otherwise it's a filename or pattern so add it at the end using 'name'
				[ "$FILE" = "$INCLUDE" ] && TEMP="${TEMP} -o -name \"${LINE}\""
				[ "$FILE" = "$EXCLUDE" ] && TEMP="${TEMP} -a ! -name \"${LINE}\""
			fi
		done <"${FILE}"
	done
	TEMP="$(echo "${TEMP}"|sed 's/ |/|/;s/| -o /| \\( /;s/| -a /| \\( /')"			# remove spacing around the '|' character and preceeding ' -o ' -or- ' -a '; For example: 'Common/ Profiles/ | -o -name=*.pdf -o name=*.db' > 'Common/ Profiles/|\( -name=*.pdf -o name=*.db'  -OR-  'Common/ Profiles/ | -a ! -name=*.pdf -a ! name=*.db' > 'Common/ Profiles/|\( ! -name=*.pdf -a ! name=*.db'
	[ "${TEMP:0:1}" = '|' ] && TEMP=".${TEMP}"		# if no directories were in the list, then add '.' at the beginning
	( ! echo "$TEMP" | grep -q '|'$ ) && TEMP="${TEMP} \\)"	# if there were included wildcards, then add the trailing '\)' to the 'find' syntax

	# NOTE: we incorporate 'find' in the command since 'tar' won't look in sub directories when using wildcards; this is a work-around
	#	we use OFMT to prevent scientific notation from being used	https://stackoverflow.com/questions/12714155/how-can-i-make-awk-not-use-scientific-notation-when-printing-small-values
	#	the below MUST come in the order presented!
	if [ "${TYPE}" = 'full' ]; then
# X - LEFT OFF - can we do a 'du -hs' here instead of going through every file on the system?
# use this as the catalog file?
		cd "${DIR_MNTS}/${RJN}.s/" && eval find ${TEMP%|*}${TEMP#*|} -type f -printf \'%s\\t%p\\n\' 2\>\>\"${DIR_LOGS}/${LOG_ERRS}\" | eval awk \'{print \$2 \>\>\"${DIR_TEMP}/${RJN}.list\"}\; {total += \$1} END {OFMT=\"%.0f\"\; print total \>\>\"${DIR_TEMP}/${RJN}.size\"}\'
	else
		# NOTE: we are using SIZE here since TEMP will be filled with 'find' syntax
		[ "${TYPE}" = 'daily' ] && SIZE="$(date +'%Y-%m-%d') 00:00:00"
		[ "${TYPE}" = 'incremental' ] && {
			SIZE=$(ls -t1 "${DIR_MNTS}/${RJN}.t/${NAME}" | grep "${EXT//./\\.}..$" | head -1)			# stores the last created file in the directory to use as the epoch for the files to now be backed up
			[ "$SIZE" ] && SIZE=$(stat -c '%x' "${DIR_MNTS}/${RJN}.t/${NAME}/${SIZE}" | sed 's/\..*//')		# if we have at least 1 prior backup, then store the *access* date of that file
			[ ! "$SIZE" ] && SIZE="$(date +'%Y-%m-%d') 00:00:00"							# if no date was obtained above (e.g. no backups exist yet), then use today as the date
		}
# LEFT OFF - test '-newerBt' (for birth/creation time)
		# the 'find' command creates a files list of what to backup and the total size of those files			  WARNING: if nothing is found to backup, then the RJN.size file will be blank and RJN.list will not exist!
		# NOTE: we use the 'access' time stamp here as it stores the epoch when the file was created (last accessed in this case)
		cd "${DIR_MNTS}/${RJN}.s/" && eval find ${TEMP%|*}${TEMP#*|} -newerat \"$SIZE\" -type f -printf \'%s\\t%p\\n\' 2\>\>\"${DIR_LOGS}/${LOG_ERRS}\" | eval awk \'{print \$2 \>\>\"${DIR_TEMP}/${RJN}.list\"}\; {total += \$1} END {OFMT=\"%.0f\"\; print total \>\>\"${DIR_TEMP}/${RJN}.size\"}\'
	fi
	SIZE=$(cat "${DIR_TEMP}/${RJN}.size")
	[ "$SIZE" ] && SIZE=$(sizeConvert "${SIZE}B" 'M')	# convert the size into MB

	# Validate the SIZE obtained above
	if [ "$SIZE" = '0' ] || [ "$SIZE" = '' ]; then		# NOTE: the SIZE=='' would occur is no files were returned from 'find' (e.g. no new data was available yet)
		echo -e " [done]\nThere does NOT appear to be any data that needs to be backed up." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		exitGraceful 0
	fi
	if ( ! echo "${SIZE}" | grep -q ^'[0-9]*'$ ); then
		echo -e " [failure]\nERROR: The size of the backup failed to be obtained." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		exitGraceful 1
	fi
	echo " [done]" | tee -a "${DIR_LOGS}/${LOG_ERRS}"


	# precycle the backups
	[ "$PRECYCLE" ] && [ cycleArchives -gt 0 ] && exitGraceful 1


	echo "Backing up the data..." >>"${DIR_LOGS}/${LOG_ERRS}"
	[ ! -e "${DIR_LOGS}/${LOG_ERRS}" ] && touch "${DIR_LOGS}/${LOG_ERRS}"			# if the log file has not yet been created, create it now so there aren't any errors below
	TEMP=$(stat -c '%s' "${DIR_LOGS}/${LOG_ERRS}")						# NOTE: we store the size of the error file before tar is executed so we know if an error occurs with it during execution (since we can't exitGraceful() upon tar failure, but only the last chained pipe command)

	# NOTE: the below single command creates the backup archive, the catalog file, and compresses all at once!
	( eval "cd "${DIR_MNTS}/${RJN}.s/" && tar -cvf - --totals ${PARAMETERS}" 2>"${DIR_TEMP}/${LOG_FIFO}" || {
		echo "ERROR: The 'tar' binary failed in its execution, exiting." | tee -a "${DIR_LOGS}/${LOG_ERRS}" 1>&2
		echo "Calling: tar -cvf - --totals ${PARAMETERS} | pv -W -w 80 -s ${SIZE}m ${COMPRESSION}>\"${DIR_MNTS}/${RJN}.t/${NAME}/${RJN}${EXT}\"" >>"${DIR_LOGS}/${LOG_ERRS}"
	} ) | eval "pv -W -w 80 -s ${SIZE}m ${COMPRESSION}>\"${DIR_MNTS}/${RJN}.t/${NAME}/${RJN}${EXT}\""

	# process any tar encountered errors above and restore verbose output if continuing
	[ $TEMP -lt $(stat -c '%s' "${DIR_LOGS}/${LOG_ERRS}") ] && {
		echo "ERROR: The 'tar' binary has completed but encountered an error." | tee -a "${DIR_LOGS}/${LOG_ERRS}"
		exitGraceful 1
	}


	# normally cycle the backups
	[ ! "$PRECYCLE" ] && [ cycleArchives -gt 0 ] && exitGraceful 1
fi




# get the sync'ed/archive byte count
if [ "$ALERT_CALL" != 'none' ]; then
	# first obtain the size of the backup archive
	[ "$TYPE" = 'sync' ] && SIZE=$(while read FILE; do stat -c %s $FILE; done <"${DIR_TEMP}/${RJN}.list" | awk '{total += $1} END {print total}')
	[ "$TYPE" != 'sync' ] && SIZE=$(stat -c %s "${DIR_MNTS}/${RJN}.t/${NAME}/${RJN}${EXT}")
	( ! echo "${SIZE}" | grep -q ^'[0-9]*'$ ) && SIZE='unknown'	# do NOT error out at this point, but just specify 'unknown' if either of the two above lines fails

# DEV NOTE: you will need to pass ALERT_CALL to the call below so it can take appropriate action based on success|failure
	# then send the backup report
	if [ "$ALERT_TYPE" = 'binary' ]; then				# if we have a command to execute, then...
		eval $ALERT >>"${DIR_LOGS}/${LOG_ERRS}" 2>&1
	else								# otherwise it is a URL to call, so...
		if [ "$ALERT_TYPE" = 'get' ]; then			#   if the call needs to be GET, then...
			curl "$ALERT_CALL" >>"${DIR_LOGS}/${LOG_ERRS}" 2>&1
		else							#   otherwise it needs to be POST, so...
			ALERT_CALL="$(echo "$ALERT_CALL" | sed -n 'h;s|.*?|-d "|;s|$|" |;p;g;s|?.*||;p' | tr '\n' '"')"		# '
# LEFT OFF - finish this
							
		fi
	fi
fi




echo -e "\n\n           $(date +'%Y-%m-%d  %H:%M:%S')" >>"${DIR_LOGS}/${LOG_ERRS}"
echo -e "----------- [ Backup Success ] -----------" >>"${DIR_LOGS}/${LOG_ERRS}"

exitGraceful 0


